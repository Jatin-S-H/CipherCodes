#include <stdio.h>
#include <string.h>
#include <ctype.h>

void trim(char s[])
{
    int start = 0, end = strlen(s) - 1;

    while (s[start] == ' ')
        start++;

    while (end >= start && s[end] == ' ')
        end--;

    memmove(s, s + start, end - start + 1);
    s[end - start + 1] = '\0';
}

int main()
{
    char input[200], key[100];
    char cipher[200], decrypted[200];
    int i, j;
    int used[26] = {0};

    printf("Enter plaintext: ");
    fgets(input, sizeof(input), stdin);
    input[strcspn(input, "\n")] = '\0';
    trim(input);

    printf("Enter 26-letter substitution key: ");
    fgets(key, sizeof(key), stdin);
    key[strcspn(key, "\n")] = '\0';
    trim(key);

    /* Check plaintext */
    if (input[0] == '\0')
    {
        printf("Plaintext cannot be empty.\n");
        return 0;
    }

    for (i = 0; input[i] != '\0'; i++)
    {
        if (input[i] != ' ' && !isalpha((unsigned char)input[i]))
        {
            printf("Digits and special characters are not allowed in plaintext.\n");
            return 0;
        }

        if (isalpha((unsigned char)input[i]))
            input[i] = toupper((unsigned char)input[i]);
    }

    /* Check key length */
    if (strlen(key) != 26)
    {
        printf("Key must contain exactly 26 letters.\n");
        return 0;
    }

    /* Check key */
    for (i = 0; i < 26; i++)
    {
        if (!isalpha((unsigned char)key[i]))
        {
            printf("Digits, spaces and special characters are not allowed in the key.\n");
            return 0;
        }

        key[i] = toupper((unsigned char)key[i]);

        if (used[key[i] - 'A'])
        {
            printf("Key must contain 26 unique letters.\n");
            return 0;
        }

        used[key[i] - 'A'] = 1;
    }

    /* Encryption */
    for (i = 0; input[i] != '\0'; i++)
    {
        if (input[i] == ' ')
        {
            cipher[i] = ' ';
        }
        else
        {
            cipher[i] = key[input[i] - 'A'];
        }
    }

    cipher[i] = '\0';

    /* Decryption */
    for (i = 0; cipher[i] != '\0'; i++)
    {
        if (cipher[i] == ' ')
        {
            decrypted[i] = ' ';
        }
        else
        {
            for (j = 0; j < 26; j++)
            {
                if (key[j] == cipher[i])
                {
                    decrypted[i] = 'A' + j;
                    break;
                }
            }
        }
    }

    decrypted[i] = '\0';

    printf("\nCiphertext: %s\n", cipher);
    printf("Decrypted Text: %s\n", decrypted);

    return 0;
}
