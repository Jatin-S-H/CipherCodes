#include <stdio.h>
#include <string.h>
#include <ctype.h>

#define KEY "QWERTYUIOPASDFGHJKLZXCVBNM"

void trim(char s[])
{
    int start = 0;
    int end = strlen(s) - 1;

    while (s[start] == ' ')
        start++;

    while (end >= start && s[end] == ' ')
        end--;

    memmove(s, s + start, end - start + 1);
    s[end - start + 1] = '\0';
}

void encrypt(char text[], char cipher[])
{
    int i;

    for (i = 0; text[i] != '\0'; i++)
    {
        if (text[i] == ' ')
            cipher[i] = ' ';
        else
            cipher[i] = KEY[text[i] - 'A'];
    }

    cipher[i] = '\0';
}

void decrypt(char cipher[], char text[])
{
    int i, j;

    for (i = 0; cipher[i] != '\0'; i++)
    {
        if (cipher[i] == ' ')
        {
            text[i] = ' ';
        }
        else
        {
            for (j = 0; j < 26; j++)
            {
                if (KEY[j] == cipher[i])
                {
                    text[i] = 'A' + j;
                    break;
                }
            }
        }
    }

    text[i] = '\0';
}

int main()
{
    char input[200];
    char cipher[200], decrypted[200];
    int i;

    printf("Substitution Key: %s\n", KEY);

    printf("Enter plaintext: ");
    fgets(input, sizeof(input), stdin);
    input[strcspn(input, "\n")] = '\0';
    trim(input);

    /* Check plaintext */
    if (input[0] == '\0')
    {
        printf("Plaintext cannot be empty.\n");
        return 0;
    }

    /* Check plaintext characters */
    for (i = 0; input[i] != '\0'; i++)
    {
        if (input[i] != ' ' && !isalpha((unsigned char)input[i]))
        {
            printf("Digits and special characters are not allowed in plaintext.\n");
            return 0;
        }

        if (isalpha((unsigned char)input[i]))
            input[i] = toupper((unsigned char)input[i]);
    }

    /* Encryption */
    encrypt(input, cipher);

    /* Decryption */
    decrypt(cipher, decrypted);

    printf("\nCiphertext: %s\n", cipher);
    printf("Decrypted Text: %s\n", decrypted);

    return 0;
}
