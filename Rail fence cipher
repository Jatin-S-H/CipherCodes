#include <stdio.h>
#include <string.h>
#include <ctype.h>

void trim(char s[])
{
    int start = 0, end = strlen(s) - 1;

    while (s[start] == ' ')
        start++;

    while (end >= start && s[end] == ' ')
        end--;

    memmove(s, s + start, end - start + 1);
    s[end - start + 1] = '\0';
}

int readRails(char input[], int *rails)
{
    int i;

    trim(input);

    if (input[0] == '\0')
        return 0;

    for (i = 0; input[i] != '\0'; i++)
    {
        if (!isdigit((unsigned char)input[i]))
            return 0;
    }

    sscanf(input, "%d", rails);

    return 1;
}

void encrypt(char text[], char cipher[], int rails)
{
    int len = strlen(text);
    char matrix[100][200] = {0};
    int row = 0;
    int direction = 1;
    int i, r, k = 0;

    /* Create zig-zag pattern */
    for (i = 0; i < len; i++)
    {
        matrix[row][i] = text[i];

        if (row == 0)
            direction = 1;
        else if (row == rails - 1)
            direction = -1;

        row += direction;
    }

    /* Read row by row */
    for (r = 0; r < rails; r++)
    {
        for (i = 0; i < len; i++)
        {
            if (matrix[r][i] != '\0')
            {
                cipher[k++] = matrix[r][i];
            }
        }
    }

    cipher[k] = '\0';
}

void decrypt(char cipher[], char text[], int rails)
{
    int len = strlen(cipher);
    char matrix[100][200] = {0};
    int row = 0;
    int direction = 1;
    int i, r, k = 0;

    /* Mark zig-zag positions */
    for (i = 0; i < len; i++)
    {
        matrix[row][i] = '*';

        if (row == 0)
            direction = 1;
        else if (row == rails - 1)
            direction = -1;

        row += direction;
    }

    /* Fill matrix using ciphertext */
    for (r = 0; r < rails; r++)
    {
        for (i = 0; i < len; i++)
        {
            if (matrix[r][i] == '*')
            {
                matrix[r][i] = cipher[k++];
            }
        }
    }

    /* Read in zig-zag order */
    row = 0;
    direction = 1;

    for (i = 0; i < len; i++)
    {
        text[i] = matrix[row][i];

        if (row == 0)
            direction = 1;
        else if (row == rails - 1)
            direction = -1;

        row += direction;
    }

    text[len] = '\0';
}

int main()
{
    char input[200], railInput[50];
    char cipher[200], decrypted[200];
    int rails;

    printf("Enter plaintext: ");
    fgets(input, sizeof(input), stdin);
    input[strcspn(input, "\n")] = '\0';
    trim(input);

    /* Check plaintext */
    if (input[0] == '\0')
    {
        printf("Plaintext cannot be empty.\n");
        return 0;
    }

    /* Convert plaintext to uppercase */
    for (int i = 0; input[i] != '\0'; i++)
    {
        if (isalpha((unsigned char)input[i]))
            input[i] = toupper((unsigned char)input[i]);
    }

    printf("Enter number of rails: ");
    fgets(railInput, sizeof(railInput), stdin);
    railInput[strcspn(railInput, "\n")] = '\0';

    /* Check rail input */
    if (!readRails(railInput, &rails))
    {
        printf("Error: Number of rails must contain only numbers.\n");
        return 0;
    }

    if (rails < 2)
    {
        printf("Error: Number of rails must be at least 2.\n");
        return 0;
    }

    if (rails > strlen(input))
    {
        printf("Error: Number of rails cannot exceed plaintext length.\n");
        return 0;
    }

    /* Encryption */
    encrypt(input, cipher, rails);

    /* Decryption */
    decrypt(cipher, decrypted, rails);

    printf("\nCiphertext: %s\n", cipher);
    printf("Decrypted Text: %s\n", decrypted);

    return 0;
}
