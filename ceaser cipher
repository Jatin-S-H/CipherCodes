#include <stdio.h>
#include <string.h>
#include <ctype.h>

void trim(char s[])
{
    int start = 0;
    int end = strlen(s) - 1;

    while (s[start] == ' ')
        start++;

    while (end >= start && s[end] == ' ')
        end--;

    memmove(s, s + start, end - start + 1);
    s[end - start + 1] = '\0';
}

int readShift(char input[], int *shift)
{
    int i;

    trim(input);

    if (input[0] == '\0')
        return 0;

    for (i = 0; input[i] != '\0'; i++)
    {
        if (!isdigit((unsigned char)input[i]))
            return 0;
    }

    sscanf(input, "%d", shift);

    return 1;
}

void encrypt(char text[], char cipher[], int shift)
{
    int i;

    for (i = 0; text[i] != '\0'; i++)
    {
        if (text[i] == ' ')
        {
            cipher[i] = ' ';
        }
        else if (isupper((unsigned char)text[i]))
        {
            cipher[i] = ((text[i] - 'A' + shift) % 26) + 'A';
        }
    }

    cipher[i] = '\0';
}

void decrypt(char cipher[], char text[], int shift)
{
    int i;

    for (i = 0; cipher[i] != '\0'; i++)
    {
        if (cipher[i] == ' ')
        {
            text[i] = ' ';
        }
        else if (isupper((unsigned char)cipher[i]))
        {
            text[i] = ((cipher[i] - 'A' - shift + 26) % 26) + 'A';
        }
    }

    text[i] = '\0';
}

int main()
{
    char input[200], shiftInput[50];
    char cipher[200], decrypted[200];
    int shift;
    int i;

    printf("Enter plaintext: ");
    fgets(input, sizeof(input), stdin);
    input[strcspn(input, "\n")] = '\0';
    trim(input);

    /* Check plaintext */
    if (input[0] == '\0')
    {
        printf("Plaintext cannot be empty.\n");
        return 0;
    }

    /* Check plaintext characters */
    for (i = 0; input[i] != '\0'; i++)
    {
        if (input[i] != ' ' && !isalpha((unsigned char)input[i]))
        {
            printf("Digits and special characters are not allowed in plaintext.\n");
            return 0;
        }

        if (isalpha((unsigned char)input[i]))
            input[i] = toupper((unsigned char)input[i]);
    }

    printf("Enter shift value: ");
    fgets(shiftInput, sizeof(shiftInput), stdin);
    shiftInput[strcspn(shiftInput, "\n")] = '\0';

    /* Check shift */
    if (!readShift(shiftInput, &shift))
    {
        printf("Error: Shift value must contain only numbers.\n");
        return 0;
    }

    if (shift < 0)
    {
        printf("Error: Shift value cannot be negative.\n");
        return 0;
    }

    shift = shift % 26;

    /* Encryption */
    encrypt(input, cipher, shift);

    /* Decryption */
    decrypt(cipher, decrypted, shift);

    printf("\nCiphertext: %s\n", cipher);
    printf("Decrypted Text: %s\n", decrypted);

    return 0;
}
